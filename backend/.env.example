# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── RAG / Qdrant ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=marketing_knowledge
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.65

# ── Graph execution ───────────────────────────────────────────────────────────
MAX_ITERATIONS=12
RECURSION_LIMIT=50

# ── Observability (optional) ──────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=marketing-ai-agents
LANGSMITH_TRACING=false
