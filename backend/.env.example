# ═══════════════════════════════════════════════════════════════════
#  AI Marketing Intelligence Platform — Configuración de entorno
# ═══════════════════════════════════════════════════════════════════
#
#  Copia este archivo como .env y edita los valores:
#    copy .env.example .env   (Windows)
#    cp .env.example .env     (Linux/Mac)
#
# ═══════════════════════════════════════════════════════════════════

# ── PROVEEDOR LLM ────────────────────────────────────────────────────────────
# Opciones: openai | ollama | mock
# - ollama: gratuito, modelos locales (recomendado para desarrollo)
# - openai: requiere API key, mejor calidad
# - mock:   sin llamadas externas, para probar el pipeline
LLM_PROVIDER=ollama

# ── OLLAMA (proveedor local gratuito) ─────────────────────────────────────────
# Descarga desde: https://ollama.com
# Instalar modelos:
#   ollama pull llama3.1:8b         (LLM principal ~4.7GB)
#   ollama pull nomic-embed-text    (embeddings ~274MB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── OPENAI (alternativa en la nube) ──────────────────────────────────────────
# Solo necesario si LLM_PROVIDER=openai o EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── PROVEEDOR EMBEDDINGS ──────────────────────────────────────────────────────
# Opciones: openai | ollama | mock
# Debe coincidir con el proveedor del LLM para mejor compatibilidad
EMBEDDING_PROVIDER=ollama

# ── QDRANT (base de datos vectorial para RAG) ─────────────────────────────────
# Levantar Qdrant con Docker:
#   docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=marketing_knowledge

# ── PARÁMETROS RAG ────────────────────────────────────────────────────────────
RAG_TOP_K=5
# Umbral de similitud (0.0-1.0). Ollama suele tener scores más bajos → usar 0.4-0.5
RAG_SCORE_THRESHOLD=0.5

# ── EJECUCIÓN DEL GRAFO ───────────────────────────────────────────────────────
MAX_ITERATIONS=12
RECURSION_LIMIT=50

# ── LLM PARÁMETROS ───────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── OBSERVABILIDAD (opcional) ─────────────────────────────────────────────────
# LangSmith para trazabilidad completa de agentes
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=marketing-ai-agents
# LANGSMITH_TRACING=false
